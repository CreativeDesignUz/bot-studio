# Central Telegram Manager Bot. Configure the real values as hosted secrets.
TELEGRAM_MANAGER_USERNAME=
TELEGRAM_MANAGER_TOKEN=
TELEGRAM_MANAGER_WEBHOOK_SECRET=
PUBLIC_APP_URL=https://app.example.com
TELEGRAM_TOKEN_ENCRYPTION_KEY=

# Server-side HMAC key (32+ random characters) for verified Google/Telegram sessions.
BOT_STUDIO_AUTH_SECRET=
# Google OAuth is configured in Supabase Authentication > Providers > Google.
# Add https://YOUR-DOMAIN/auth/callback to Supabase URL allow-list.
# Telegram Login Widget requires BotFather /setdomain for YOUR-DOMAIN.
